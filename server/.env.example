# ------------------------------------------------------------------
# Server
# ------------------------------------------------------------------
NODE_ENV=development
PORT=5001

# ------------------------------------------------------------------
# MongoDB
# ------------------------------------------------------------------
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/auth_db?retryWrites=true&w=majority&appName=Cluster0

# ------------------------------------------------------------------
# JWT
# ------------------------------------------------------------------
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# ------------------------------------------------------------------
# Cookies / CORS
# ------------------------------------------------------------------
CLIENT_URL=http://localhost:5173
COOKIE_NAME=dashcore_token
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Absolute base URL used to build password-reset links in emails.
# In development leave this as the Vite origin (proxied to Express).
# In production set it to the public origin, e.g. https://dashcore.example.com
APP_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# SMTP (optional) — password-reset emails
# If SMTP_HOST is unset, the server logs the reset link to the console
# instead of sending, which is convenient during development.
# ---------------------------------------------------------------------------
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=smtp_user
# SMTP_PASS=smtp_password
# MAIL_FROM="DashCore <no-reply@dashcore.example.com>"
